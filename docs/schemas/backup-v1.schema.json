{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campus-hire-tracker.local/schemas/backup-v1.schema.json",
  "title": "Campus Hire Tracker data.json backup format v1",
  "description": "Structural schema for the deterministic relational snapshot. The restore service additionally validates table-specific columns, keys, foreign keys, enums, domain invariants, ordering, and attachment membership.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "exportedAtMs",
    "sourceSchemaVersion",
    "workspaceId",
    "tables",
    "excludedTables"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "exportedAtMs": {
      "$ref": "#/$defs/nonNegativeSafeInteger"
    },
    "sourceSchemaVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "workspaceId": {
      "$ref": "#/$defs/opaqueId"
    },
    "tables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaces",
        "workspace_settings",
        "companies",
        "positions",
        "applications",
        "tags",
        "application_tags",
        "material_tags",
        "events",
        "event_reminders",
        "interview_rounds",
        "recruitment_fairs",
        "recruitment_fair_targets",
        "materials",
        "material_links",
        "attachments",
        "timeline_entries",
        "capture_drafts",
        "ai_provider_configs",
        "import_runs",
        "import_changes"
      ],
      "properties": {
        "workspaces": {
          "$ref": "#/$defs/singleIdRows"
        },
        "workspace_settings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workspaceSettingsRow"
          }
        },
        "companies": {
          "$ref": "#/$defs/singleIdRows"
        },
        "positions": {
          "$ref": "#/$defs/singleIdRows"
        },
        "applications": {
          "$ref": "#/$defs/singleIdRows"
        },
        "tags": {
          "$ref": "#/$defs/singleIdRows"
        },
        "application_tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/applicationTagRow"
          }
        },
        "material_tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/materialTagRow"
          }
        },
        "events": {
          "$ref": "#/$defs/singleIdRows"
        },
        "event_reminders": {
          "$ref": "#/$defs/singleIdRows"
        },
        "interview_rounds": {
          "$ref": "#/$defs/singleIdRows"
        },
        "recruitment_fairs": {
          "$ref": "#/$defs/singleIdRows"
        },
        "recruitment_fair_targets": {
          "$ref": "#/$defs/singleIdRows"
        },
        "materials": {
          "$ref": "#/$defs/singleIdRows"
        },
        "material_links": {
          "$ref": "#/$defs/singleIdRows"
        },
        "attachments": {
          "$ref": "#/$defs/singleIdRows"
        },
        "timeline_entries": {
          "$ref": "#/$defs/singleIdRows"
        },
        "capture_drafts": {
          "$ref": "#/$defs/singleIdRows"
        },
        "ai_provider_configs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aiProviderConfigRow"
          }
        },
        "import_runs": {
          "$ref": "#/$defs/singleIdRows"
        },
        "import_changes": {
          "$ref": "#/$defs/singleIdRows"
        }
      }
    },
    "excludedTables": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "const": "backup_runs"
        },
        {
          "const": "file_gc_jobs"
        },
        {
          "const": "outbox"
        },
        {
          "const": "__drizzle_migrations"
        }
      ],
      "items": false
    }
  },
  "$defs": {
    "safeInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "nonNegativeSafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "nullableOpaqueId": {
      "oneOf": [
        {
          "$ref": "#/$defs/opaqueId"
        },
        {
          "type": "null"
        }
      ]
    },
    "scalar": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/safeInteger"
        }
      ]
    },
    "genericValues": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/scalar"
      }
    },
    "singleIdRows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/singleIdRow"
      }
    },
    "singleIdRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "values"
      ],
      "properties": {
        "key": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [
            {
              "$ref": "#/$defs/opaqueId"
            }
          ],
          "items": false
        },
        "values": {
          "type": "object",
          "minProperties": 1,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/opaqueId"
            }
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/scalar"
          }
        }
      }
    },
    "workspaceSettingsRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "values"
      ],
      "properties": {
        "key": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [
            {
              "$ref": "#/$defs/opaqueId"
            }
          ],
          "items": false
        },
        "values": {
          "type": "object",
          "minProperties": 1,
          "required": [
            "workspace_id"
          ],
          "properties": {
            "workspace_id": {
              "$ref": "#/$defs/opaqueId"
            }
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/scalar"
          }
        }
      }
    },
    "applicationTagRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "values"
      ],
      "properties": {
        "key": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "$ref": "#/$defs/opaqueId"
            },
            {
              "$ref": "#/$defs/opaqueId"
            },
            {
              "$ref": "#/$defs/opaqueId"
            }
          ],
          "items": false
        },
        "values": {
          "type": "object",
          "required": [
            "workspace_id",
            "application_id",
            "tag_id"
          ],
          "properties": {
            "workspace_id": {
              "$ref": "#/$defs/opaqueId"
            },
            "application_id": {
              "$ref": "#/$defs/opaqueId"
            },
            "tag_id": {
              "$ref": "#/$defs/opaqueId"
            },
            "created_at_ms": {
              "$ref": "#/$defs/nonNegativeSafeInteger"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "materialTagRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "values"
      ],
      "properties": {
        "key": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "$ref": "#/$defs/opaqueId"
            },
            {
              "$ref": "#/$defs/opaqueId"
            },
            {
              "$ref": "#/$defs/opaqueId"
            }
          ],
          "items": false
        },
        "values": {
          "type": "object",
          "required": [
            "workspace_id",
            "material_id",
            "tag_id"
          ],
          "properties": {
            "workspace_id": {
              "$ref": "#/$defs/opaqueId"
            },
            "material_id": {
              "$ref": "#/$defs/opaqueId"
            },
            "tag_id": {
              "$ref": "#/$defs/opaqueId"
            },
            "created_at_ms": {
              "$ref": "#/$defs/nonNegativeSafeInteger"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "aiProviderConfigRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "values"
      ],
      "properties": {
        "key": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [
            {
              "$ref": "#/$defs/opaqueId"
            }
          ],
          "items": false
        },
        "values": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "workspace_id",
            "display_name",
            "provider_kind",
            "endpoint_url",
            "model_name",
            "enabled",
            "created_at_ms",
            "updated_at_ms",
            "version"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/opaqueId"
            },
            "workspace_id": {
              "$ref": "#/$defs/opaqueId"
            },
            "display_name": {
              "type": "string"
            },
            "provider_kind": {
              "const": "OPENAI_COMPATIBLE"
            },
            "endpoint_url": {
              "type": "string"
            },
            "model_name": {
              "type": "string"
            },
            "enabled": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            },
            "created_at_ms": {
              "$ref": "#/$defs/nonNegativeSafeInteger"
            },
            "updated_at_ms": {
              "$ref": "#/$defs/nonNegativeSafeInteger"
            },
            "version": {
              "$ref": "#/$defs/nonNegativeSafeInteger"
            },
            "deleted_at_ms": {
              "oneOf": [
                {
                  "$ref": "#/$defs/nonNegativeSafeInteger"
                },
                {
                  "type": "null"
                }
              ]
            },
            "delete_operation_id": {
              "$ref": "#/$defs/nullableOpaqueId"
            }
          }
        }
      }
    }
  }
}
